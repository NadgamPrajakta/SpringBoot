package Student.Management.Student.Controller;

import java.util.ArrayList;
import java.util.List;
import java.util.stream.Collectors;

import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import Student.Management.Student.DTO.StudentDto;
import Student.Management.Student.Details.Student;;

@RestController
@RequestMapping("/student")
public class StudentController {

    List<Student> db = new ArrayList<Student>();

    @PostMapping("/add")
    public Student add(@RequestBody Student student) {
        db.add(student);
        return student;
    }

    @GetMapping("/all")
    public List<StudentDto> getAll() {

        return db.stream()
                .map((s) -> {
                    StudentDto dto = new StudentDto();
                    dto.setSid(s.getSid());
                    dto.setName(s.getName());
                    dto.setCollegeName(s.getCollege().getCollegeName());
                    dto.setUniversity(s.getCollege().getUniversity());
                    return dto;
                })
                .collect(Collectors.toList());
    }
}
